{
  "name": "MuscleMeasurement",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Sesi\u00f3n de medici\u00f3n a la que pertenece la muestra"
    },
    "patient_id": {
      "type": "string",
      "description": "Paciente asociado a la muestra"
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de recepci\u00f3n de la muestra"
    },
    "elapsed_ms": {
      "type": "number",
      "description": "Milisegundos transcurridos desde el inicio de la medici\u00f3n"
    },
    "isquio": {
      "type": "number",
      "description": "\u00cdndice de actividad isquiotibial (0-100)"
    },
    "vasto_interno": {
      "type": "number",
      "description": "\u00cdndice de actividad vasto interno (0-100)"
    },
    "vasto_externo": {
      "type": "number",
      "description": "\u00cdndice de actividad vasto externo (0-100)"
    },
    "simulated": {
      "type": "boolean",
      "default": true,
      "description": "Indica si la muestra proviene de datos simulados"
    }
  },
  "required": [
    "session_id",
    "received_at"
  ]
}