{
  "name": "SessionSummary",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Sesi\u00f3n de medici\u00f3n resumida"
    },
    "patient_id": {
      "type": "string",
      "description": "Paciente asociado al resumen"
    },
    "max_isquio": {
      "type": "number",
      "description": "Mayor \u00edndice de actividad isquiotibial de la sesi\u00f3n"
    },
    "max_vasto_interno": {
      "type": "number",
      "description": "Mayor \u00edndice de actividad del vasto interno de la sesi\u00f3n"
    },
    "max_vasto_externo": {
      "type": "number",
      "description": "Mayor \u00edndice de actividad del vasto externo de la sesi\u00f3n"
    },
    "sample_count": {
      "type": "number",
      "description": "Cantidad de muestras v\u00e1lidas consideradas"
    },
    "simulated": {
      "type": "boolean",
      "default": true,
      "description": "Indica si el resumen proviene de datos simulados"
    }
  },
  "required": [
    "session_id"
  ]
}