{
  "name": "Friendship",
  "type": "object",
  "properties": {
    "requester_patient_id": {
      "type": "string",
      "description": "Paciente que envi\u00f3 la solicitud de conexi\u00f3n"
    },
    "addressee_patient_id": {
      "type": "string",
      "description": "Paciente que recibe la solicitud de conexi\u00f3n"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendiente",
        "aceptada",
        "rechazada"
      ],
      "default": "pendiente",
      "description": "Estado de la conexi\u00f3n entre ambos pacientes"
    }
  },
  "required": [
    "requester_patient_id",
    "addressee_patient_id"
  ]
}